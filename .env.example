# Copy to .env (git-ignored). Values: Anthropic key from the YourAI project's .env (SCP_LLM_API_KEY) per Innocent, 2026-10-20.
# Names only; never put a value in this file.

# Required: start-up stops with the variable's name when any of these is missing or blank
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MERIDIAN_DEMO_USERNAME=
MERIDIAN_DEMO_PASSWORD=
MERIDIAN_SESSION_SECRET=

# Optional Langfuse export: all four or export stays off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=

# Optional web, storage and version settings (code defaults apply when unset)
MERIDIAN_EVAL_KEY=
MERIDIAN_COOKIE_SECURE=
MERIDIAN_TRUST_PROXY_HEADERS=
MERIDIAN_WEB_DIST_DIR=
MERIDIAN_REQUIRE_FRONTEND=
MERIDIAN_WARM_RETRIEVAL=
MERIDIAN_DATA_DIR=
MERIDIAN_INDEX_DIR=
MERIDIAN_AGENT_VERSION=
